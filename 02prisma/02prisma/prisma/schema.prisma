generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Student {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  email       String   @unique
  age         Int
  department  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
model User {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  email       String  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime  @updatedAt
}