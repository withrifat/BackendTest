model Book {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  title         String
  isbn          String   @unique
  description   String?
  publishedYear Int?
  authorId      String   @db.ObjectId
  author        Author   @relation(fields: [authorId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}